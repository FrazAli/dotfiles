#!/usr/bin/env bash

set -euo pipefail

config_file="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/settings.json"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
scheme_name="Nord-Readable-Hover"
scheme_source="$script_dir/colorschemes/$scheme_name/$scheme_name.json"
scheme_directory="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/colorschemes/$scheme_name"
temporary_file="$(mktemp)"
trap 'rm -f -- "$temporary_file"' EXIT

install -d -m 0755 "$scheme_directory"
install -m 0644 "$scheme_source" "$scheme_directory/$scheme_name.json"

jq -f "$script_dir/bar-layout.jq" "$config_file" > "$temporary_file"
jq --exit-status '.' "$temporary_file" >/dev/null
install -m 0644 "$temporary_file" "$config_file"

echo "Applied the Noctalia v4 bar layout and $scheme_name palette to $config_file"
