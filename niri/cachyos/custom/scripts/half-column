#!/usr/bin/env bash

# Approximate Rectangle's left-half and right-half actions in Niri by arranging
# the focused column and its neighbor as an equal-width pair.
#
# Usage:
#
#   half-column left
#   half-column right
#
# The focused column is resized to 50% and moved in the requested direction.
# The adjacent column is then resized to 50%, the original window is focused
# again, and the visible pair is centered. When there is no adjacent column,
# the window is floated and placed on the requested screen half; a lone tiled
# column cannot be aligned to a screen edge in Niri's scrolling layout.
#
# With multiple columns, left and right describe the focused column's position
# relative to its neighbor, following Niri's scrolling-column model.
#
# This is a script because a Niri keybinding accepts only one action.

set -euo pipefail

direction="${1:?missing direction}"

case "$direction" in
    left)
        adjacent_direction="right"
        ;;
    right)
        adjacent_direction="left"
        ;;
    *)
        printf 'Unknown direction: %s\n' "$direction" >&2
        exit 2
        ;;
esac

focused_window="$(niri msg -j focused-window)"
focused_window_id="$(jq -r '.id' <<< "$focused_window")"
is_floating="$(jq -r '.is_floating' <<< "$focused_window")"

place_on_screen_half() {
    niri msg action move-window-to-floating --id "$focused_window_id"
    niri msg action set-window-width --id "$focused_window_id" "50%"
    niri msg action set-window-height --id "$focused_window_id" "100%"

    if [[ "$direction" == left ]]; then
        x_position="0"
    else
        x_position="50%"
    fi

    niri msg action move-floating-window --id "$focused_window_id" \
        --x "$x_position" --y 0
}

if [[ "$is_floating" == true ]]; then
    place_on_screen_half
else
    niri msg action set-column-width "50%"
    niri msg action "move-column-$direction"
    niri msg action "focus-column-$adjacent_direction"

    adjacent_window_id="$(niri msg -j focused-window | jq -r '.id')"
    if [[ "$adjacent_window_id" != "$focused_window_id" ]]; then
        niri msg action set-column-width "50%"
        niri msg action focus-window --id "$focused_window_id"
        niri msg action center-visible-columns
    else
        place_on_screen_half
    fi
fi
