// Personal window and layer rules.

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

// Ghostty 1.3 does not request Niri's background-effect protocol itself.
// Keep opacity in Ghostty and let Niri blur the content behind the window.
window-rule {
    match app-id="^com\\.mitchellh\\.ghostty$"

    background-effect {
        blur true
    }
}

// Slightly fade unfocused windows while preserving Ghostty's own transparency.
window-rule {
    match is-focused=false
    exclude app-id="^com\\.mitchellh\\.ghostty$"

    opacity 0.94
}
